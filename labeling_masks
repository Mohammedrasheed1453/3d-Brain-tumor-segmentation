import os
import numpy as np
import nibabel as nib

def create_new_labels(mask_volume):
    """
    Create new labels from the original mask volume.

    Args:
    mask_volume (numpy array): 3D mask image with original labels (0, 1, 2, 3, 4).

    Returns:
    new_mask (numpy array): 3D mask image with new labels (ET, TC, WT).
    """
    # Initialize new labels
    new_mask = np.zeros((3, *mask_volume.shape), dtype=np.float32)  # Shape: (3, 128, 128, 128)

    # ET: Enhancing Tumor (label 4)
    new_mask[0] = np.where(mask_volume == 4, 1, 0)  # ET

    # TC: Tumor Core (labels 1 + 4)
    new_mask[1] = np.where(np.isin(mask_volume, [1, 4]), 1, 0)  # TC

    # WT: Whole Tumor (labels 1 + 2 + 4)
    new_mask[2] = np.where(np.isin(mask_volume, [1, 2, 4]), 1, 0)  # WT

    return new_mask

def process_segmentations(base_directory):
    """
    Process all cropped segmentation images to create new labels.

    Args:
    base_directory (str): Path to the base directory containing patient folders.
    """
    for patient_dir in os.listdir(base_directory):
        patient_path = os.path.join(base_directory, patient_dir)
        if os.path.isdir(patient_path):
            mask_path = os.path.join(patient_path, 'cropped_seg.nii.gz')
            if os.path.exists(mask_path):
                try:
                    # Load the cropped segmentation mask
                    mask_img = nib.load(mask_path)
                    mask_data = mask_img.get_fdata()

                    # Create new labels
                    new_labels = create_new_labels(mask_data)

                    # Save the new mask as NIfTI
                    new_mask_img = nib.Nifti1Image(new_labels, affine=mask_img.affine)
                    nib.save(new_mask_img, os.path.join(patient_path, 'new_labels.nii.gz'))

                    print(f"New labels created for {patient_dir} and saved.")
                except Exception as e:
                    print(f"Failed to process {patient_dir}: {e}")
            else:
                print(f"Mask file not found for {patient_dir}: {mask_path}")

# Example usage
base_directory = '/content/BraTS2020_Train/MICCAI_BraTS2020_TrainingData'  # Update as needed
process_segmentations(base_directory)
