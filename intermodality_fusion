import os
import nibabel as nib
import numpy as np

def fuse_modalities(patient_path, modalities=['flair', 't1', 't1ce', 't2']):
    """
    Fuse cropped volumes from multiple modalities into a single 4D array.

    Args:
    patient_path (str): Path to the patient's directory containing cropped volumes.
    modalities (list): List of modality suffixes to combine (default: ['flair', 't1', 't1ce', 't2']).

    Returns:
    fused_image (numpy array): 4D array containing fused data of shape (128, 128, 128, num_modalities).
    """
    modality_images = []

    for modality in modalities:
        modality_path = os.path.join(patient_path, f"cropped_{modality}.nii.gz")
        if os.path.exists(modality_path):
            # Load each modality's cropped image
            img = nib.load(modality_path)
            modality_data = img.get_fdata()

            # Ensure the modality data has the expected dimensions
            if modality_data.shape == (128, 128, 128):
                modality_images.append(modality_data)
            else:
                raise ValueError(f"Unexpected shape {modality_data.shape} for {modality}")

    if len(modality_images) != len(modalities):
        raise ValueError("Not all specified modalities were found for fusion.")

    # Stack along a new axis to create a 4D array (128, 128, 128, 4)
    fused_image = np.stack(modality_images, axis=-1)

    return fused_image

def process_all_patients(base_directory):
    """
    Apply inter-modality fusion on all patients' cropped images.

    Args:
    base_directory (str): Path to the base directory containing patient folders.
    """
    for patient_dir in os.listdir(base_directory):
        patient_path = os.path.join(base_directory, patient_dir)
        if os.path.isdir(patient_path):
            try:
                # Fuse modalities for the patient
                fused_image = fuse_modalities(patient_path)

                # Save the fused 4D image as NIfTI
                affine = nib.load(os.path.join(patient_path, f"cropped_flair.nii.gz")).affine
                fused_img_nifti = nib.Nifti1Image(fused_image, affine)
                nib.save(fused_img_nifti, os.path.join(patient_path, "fused_modalities.nii.gz"))

                print(f"Inter-modality fusion completed for {patient_dir} and saved.")
            except Exception as e:
                print(f"Failed to process {patient_dir}: {e}")

# Example usage
base_directory = '/content/BraTS2020_Train/MICCAI_BraTS2020_TrainingData'  # Update as needed
