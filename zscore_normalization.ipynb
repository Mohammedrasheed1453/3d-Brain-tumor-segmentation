import os
import nibabel as nib
import numpy as np

def z_score_normalize(volume):
    """
    Apply z-score normalization to a 4D volume (128, 128, 128, num_modalities).

    Args:
    volume (numpy array): 4D array with shape (128, 128, 128, num_modalities).

    Returns:
    normalized_volume (numpy array): Z-score normalized 4D array.
    """
    # Initialize an array to hold the normalized data
    normalized_volume = np.zeros_like(volume)

    # Apply z-score normalization on each modality channel
    for i in range(volume.shape[-1]):
        modality = volume[..., i]
        mean = modality.mean()
        std = modality.std()

        # Avoid division by zero
        if std != 0:
            normalized_volume[..., i] = (modality - mean) / std
        else:
            normalized_volume[..., i] = modality - mean

    return normalized_volume

def normalize_all_patients(base_directory):
    """
    Apply z-score normalization to all fused images in the specified directory.

    Args:
    base_directory (str): Path to the base directory containing patient folders.
    """
    for patient_dir in os.listdir(base_directory):
        patient_path = os.path.join(base_directory, patient_dir)
        if os.path.isdir(patient_path):
            fused_path = os.path.join(patient_path, "fused_modalities.nii.gz")
            if os.path.exists(fused_path):
                try:
                    # Load the fused 4D image
                    fused_img = nib.load(fused_path)
                    fused_data = fused_img.get_fdata()

                    # Normalize the fused image
                    normalized_data = z_score_normalize(fused_data)

                    # Save the normalized image as NIfTI
                    normalized_img_nifti = nib.Nifti1Image(normalized_data, affine=fused_img.affine)
                    nib.save(normalized_img_nifti, os.path.join(patient_path, "normalized_fused_modalities.nii.gz"))

                    print(f"Normalization completed for {patient_dir} and saved.")
                except Exception as e:
                    print(f"Failed to process {patient_dir}: {e}")

# Example usage
base_directory = '/content/BraTS2020_Train/MICCAI_BraTS2020_TrainingData'  # Update as needed
normalize_all_patients(base_directory)
