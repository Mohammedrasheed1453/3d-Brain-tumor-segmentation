import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import DataLoader, Dataset
import nibabel as nib
import os
from typing import List, Tuple
import numpy as np
from pathlib import Path
from tqdm import tqdm
import matplotlib.pyplot as plt

# Double convolution block
class DoubleConv3D(nn.Module):
    """Double 3D convolution block with batch normalization."""
    def __init__(self, in_channels: int, out_channels: int):
        super().__init__()
        self.conv = nn.Sequential(
            nn.Conv3d(in_channels, out_channels, kernel_size=3, padding=1),
            nn.BatchNorm3d(out_channels),
            nn.ReLU(inplace=True),
            nn.Conv3d(out_channels, out_channels, kernel_size=3, padding=1),
            nn.BatchNorm3d(out_channels),
            nn.ReLU(inplace=True)
        )

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self.conv(x)

# 3D U-Net Model
class UNet3D(nn.Module):
    """3D U-Net without Contextual Transformer Block."""
    def __init__(self, n_channels: int, n_classes: int):
        super().__init__()

        # Encoder
        self.in_conv = DoubleConv3D(n_channels, 64)
        self.down1 = nn.Sequential(nn.MaxPool3d(2), DoubleConv3D(64, 128))
        self.down2 = nn.Sequential(nn.MaxPool3d(2), DoubleConv3D(128, 256))
        self.down3 = nn.Sequential(nn.MaxPool3d(2), DoubleConv3D(256, 512))

        # Decoder
        self.up1 = nn.ConvTranspose3d(512, 256, kernel_size=2, stride=2)
        self.conv1 = DoubleConv3D(512, 256)  # 512 due to concatenation
        self.up2 = nn.ConvTranspose3d(256, 128, kernel_size=2, stride=2)
        self.conv2 = DoubleConv3D(256, 128)  # 256 due to concatenation
        self.up3 = nn.ConvTranspose3d(128, 64, kernel_size=2, stride=2)
        self.conv3 = DoubleConv3D(128, 64)   # 128 due to concatenation

        # Output layer
        self.out_conv = nn.Conv3d(64, n_classes, kernel_size=1)

        # Initialize weights
        self.apply(self._init_weights)

    @staticmethod
    def _init_weights(m):
        if isinstance(m, (nn.Conv3d, nn.ConvTranspose3d)):
            nn.init.kaiming_normal_(m.weight, mode='fan_out', nonlinearity='relu')
            if m.bias is not None:
                nn.init.constant_(m.bias, 0)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        # Encoder path
        x1 = self.in_conv(x)      # Level 1 features
        x2 = self.down1(x1)       # Level 2 features
        x3 = self.down2(x2)       # Level 3 features
        x4 = self.down3(x3)       # Bottom level features

        # Decoder path with skip connections
        x = self.up1(x4)
        x = torch.cat([x, x3], dim=1)
        x = self.conv1(x)

        x = self.up2(x)
        x = torch.cat([x, x2], dim=1)
        x = self.conv2(x)

        x = self.up3(x)
        x = torch.cat([x, x1], dim=1)
        x = self.conv3(x)

        return self.out_conv(x)

# Dataset class
class BrainDataset(Dataset):
    """Dataset class for brain MRI data."""
    def __init__(self, base_path: str, image_files: List[str], label_files: List[str]):
        self.base_path = Path(base_path)
        self.image_files = image_files
        self.label_files = label_files
        assert len(image_files) == len(label_files), "Number of images and labels must match"

    def __len__(self) -> int:
        return len(self.image_files)

    def __getitem__(self, idx: int) -> Tuple[torch.Tensor, torch.Tensor]:
        image_path = self.base_path / self.image_files[idx]
        label_path = self.base_path / self.label_files[idx]
        image = nib.load(str(image_path)).get_fdata()
        image = torch.tensor(image, dtype=torch.float32).permute(3, 0, 1, 2)
        label = nib.load(str(label_path)).get_fdata()
        label = torch.tensor(label, dtype=torch.float32)
        label = torch.argmax(label, dim=0)
        return image, label.long()

# Training function
def train_model(
    model: nn.Module,
    train_loader: DataLoader,
    criterion: nn.Module,
    optimizer: optim.Optimizer,
    device: torch.device,
    num_epochs: int,
    val_loader: DataLoader = None,
    save_path: str = "trained_model_complete.pth"
) -> dict:
    """Train the model and save weights and the complete model."""
    history = {'train_loss': [], 'val_loss': [] if val_loader else None}
    for epoch in range(num_epochs):
        model.train()
        running_loss = 0.0
        with tqdm(train_loader, desc=f'Epoch {epoch+1}/{num_epochs}') as pbar:
            for images, labels in pbar:
                images, labels = images.to(device), labels.to(device)
                optimizer.zero_grad()
                outputs = model(images)
                loss = criterion(outputs, labels)
                loss.backward()
                optimizer.step()
                running_loss += loss.item()
                pbar.set_postfix({'loss': loss.item()})
        epoch_loss = running_loss / len(train_loader)
        history['train_loss'].append(epoch_loss)
        if val_loader:
            val_loss = validate_model(model, val_loader, criterion, device)
            history['val_loss'].append(val_loss)
            print(f'Epoch {epoch+1}: Train Loss: {epoch_loss:.4f}, Val Loss: {val_loss:.4f}')
        else:
            print(f'Epoch {epoch+1}: Train Loss: {epoch_loss:.4f}')
    torch.save(model, save_path)  # Save entire model
    torch.save(model.state_dict(), save_path.replace(".pth", "_weights.pth"))  # Save model weights
    print(f"Model and weights saved to {save_path} and {save_path.replace('.pth', '_weights.pth')}")
    return history

# Validation function
def validate_model(model: nn.Module, val_loader: DataLoader, criterion: nn.Module, device: torch.device) -> float:
    model.eval()
    val_loss = 0.0
    with torch.no_grad():
        for images, labels in val_loader:
            images, labels = images.to(device), labels.to(device)
            outputs = model(images)
            loss = criterion(outputs, labels)
            val_loss += loss.item()
    return val_loss / len(val_loader)

# Helper function to get matching files
def get_matching_files(base_path: Path) -> Tuple[List[str], List[str]]:
    all_files = os.listdir(base_path)
    image_files, label_files = [], []
    for file in all_files:
        if "normalized_fused_modalities" in file:
            patient_id = file.split('normalized_fused_modalities')[0]
            label_file = next((lfile for lfile in all_files if "new_labels" in lfile and patient_id in lfile), None)
            if label_file:
                image_files.append(file)
                label_files.append(label_file)
    return image_files, label_files

# Plotting function
def plot_loss(history: dict):
    plt.figure(figsize=(10, 5))
    plt.plot(history['train_loss'], label='Train Loss')
    if history['val_loss'] is not None:
        plt.plot(history['val_loss'], label='Validation Loss')
    plt.xlabel('Epoch')
    plt.ylabel('Loss')
    plt.title('Loss vs Epoch')
    plt.legend()
    plt.show()

# Visualization function
def visualize_predictions(model, data_loader, device, num_images=5):
    model.eval()
    images_shown = 0
    with torch.no_grad():
        for images, labels in data_loader:
            images, labels = images.to(device), labels.to(device)
            outputs = model(images)
            preds = torch.argmax(outputs, dim=1)

            # Display images, ground truths, and predictions
            for i in range(min(num_images, images.shape[0])):
                fig, axs = plt.subplots(1, 3, figsize=(15, 5))
                axs[0].imshow(images[i, 0, :, :, images.shape[2] // 2].cpu(), cmap='gray')
                axs[0].set_title("MRI Image")
                axs[1].imshow(labels[i, :, :, labels.shape[2] // 2].cpu(), cmap='gray')
                axs[1].set_title("Ground Truth")
                axs[2].imshow(preds[i, :, :, preds.shape[2] // 2].cpu(), cmap='gray')
                axs[2].set_title("Prediction")
                plt.show()
                images_shown += 1
                if images_shown >= num_images:
                    return

# Main function
def main():
    CONFIG = {
        'base_drive_path': "/content/drive/MyDrive/Processed_Data",
        'n_channels': 4,
        'n_classes': 3,
        'batch_size': 32,
        'learning_rate': 0.001,
        'num_epochs': 8,
        'model_save_path': "/content/drive/MyDrive/Processed_Data/trained_model_complete.pth"
    }

    # Ensure model save directory exists
    model_dir = os.path.dirname(CONFIG['model_save_path'])
    os.makedirs(model_dir, exist_ok=True)

    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"Using device: {device}")

    base_path = Path(CONFIG['base_drive_path'])
    if not base_path.exists():
        raise FileNotFoundError(f"Directory {CONFIG['base_drive_path']} does not exist")

    # Get image and label files
    image_files, label_files = get_matching_files(base_path)
    dataset = BrainDataset(base_path, image_files[:100], label_files[:100])  # Using only 100 images for example

    train_loader = DataLoader(dataset, batch_size=CONFIG['batch_size'], shuffle=True)

    # Initialize model, loss function, and optimizer
    model = UNet3D(CONFIG['n_channels'], CONFIG['n_classes']).to(device)
    criterion = nn.CrossEntropyLoss()
    optimizer = optim.Adam(model.parameters(), lr=CONFIG['learning_rate'])

    # Train the model
    history = train_model(
        model,
        train_loader,
        criterion,
        optimizer,
        device,
        CONFIG['num_epochs'],
        save_path=CONFIG['model_save_path']
    )
    print("Training complete.")

    # Plot loss vs epoch
    plot_loss(history)

    # Visualize predictions
    visualize_predictions(model, train_loader, device, num_images=5)

if __name__ == "__main__":
    main()
