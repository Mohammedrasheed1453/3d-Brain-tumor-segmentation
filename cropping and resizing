import os
import numpy as np
import nibabel as nib
from scipy.ndimage import zoom

def crop_and_resize(volume, target_shape=(128, 128, 128), mask=None):
    """
    Crop unnecessary black borders from a 3D volume and resize to target shape.
    If a mask is provided, it will also be cropped and resized accordingly.

    Args:
    volume (numpy array): 3D MRI scan.
    target_shape (tuple): Desired output shape (default is 128x128x128).
    mask (numpy array, optional): 3D mask corresponding to the volume.

    Returns:
    resized_volume (numpy array): Cropped and resized MRI scan.
    resized_mask (numpy array, optional): Cropped and resized mask, if provided.
    """
    # Get non-zero boundaries for cropping
    non_zero_coords = np.argwhere(volume > 0)
    if non_zero_coords.size == 0:
        raise ValueError("The volume is empty or all-zero.")
    x_min, y_min, z_min = non_zero_coords.min(axis=0)
    x_max, y_max, z_max = non_zero_coords.max(axis=0)

    # Crop the volume and mask (if provided)
    cropped_volume = volume[x_min:x_max+1, y_min:y_max+1, z_min:z_max+1]

    # Resize cropped volume to target shape
    zoom_factors = [target_dim / cropped_dim for target_dim, cropped_dim in zip(target_shape, cropped_volume.shape)]
    resized_volume = zoom(cropped_volume, zoom_factors, order=1)  # 'order=1' for bilinear interpolation

    if mask is not None:
        cropped_mask = mask[x_min:x_max+1, y_min:y_max+1, z_min:z_max+1]
        resized_mask = zoom(cropped_mask, zoom_factors, order=0)  # 'order=0' for nearest-neighbor interpolation on mask
        return resized_volume, resized_mask

    return resized_volume

def process_directory(base_directory):
    """
    Process all MRI modalities and mask images in the specified directory.

    Args:
    base_directory (str): The path to the base directory containing patient folders.
    """
    modalities = ['flair', 't1', 't1ce', 't2']  # The four modalities

    for patient_dir in os.listdir(base_directory):
        patient_path = os.path.join(base_directory, patient_dir)
        if os.path.isdir(patient_path):
            try:
                # Load, crop, and resize each modality
                for modality in modalities:
                    mri_path = os.path.join(patient_path, f"{patient_dir}_{modality}.nii")
                    if os.path.exists(mri_path):
                        mri_img = nib.load(mri_path)
                        mri_data = mri_img.get_fdata()

                        # Perform cropping and resizing
                        resized_mri = crop_and_resize(mri_data, target_shape=(128, 128, 128))

                        # Save the resized modality image
                        resized_mri_img = nib.Nifti1Image(resized_mri, affine=mri_img.affine)
                        nib.save(resized_mri_img, os.path.join(patient_path, f"cropped_{modality}.nii.gz"))

                # Process the segmentation mask
                mask_path = os.path.join(patient_path, f"{patient_dir}_seg.nii")
                if os.path.exists(mask_path):
                    mask_img = nib.load(mask_path)
                    mask_data = mask_img.get_fdata()

                    # Perform cropping and resizing on the mask
                    resized_mask = crop_and_resize(mask_data, target_shape=(128, 128, 128))

                    # Save the resized segmentation mask
                    resized_mask_img = nib.Nifti1Image(resized_mask, affine=mask_img.affine)
                    nib.save(resized_mask_img, os.path.join(patient_path, 'cropped_seg.nii.gz'))

                print(f"Cropping and resizing completed for {patient_dir} and saved.")
            except Exception as e:
                print(f"Failed to process {patient_dir}: {e}")

# Example usage
base_directory = '/content/BraTS2020_Train/MICCAI_BraTS2020_TrainingData'  # Update this as needed
process_directory(base_directory)
